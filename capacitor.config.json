{
  "appId": "com.studiosedillo.flushfactor",
  "appName": "The Flush Factor",
  "webDir": "dist/app",
  "backgroundColor": "#1f2a33",
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
  },
  "ios": {
    "contentInset": "never",
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover"
    }
  }
}
