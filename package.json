{
  "name": "the-flush-factor",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "serve": "node tools/serve.mjs 5000",
    "build": "node tools/build-icons.mjs && node tools/build-sw.mjs",
    "icons": "node tools/build-icons.mjs --download",
    "assets": "bash tools/optimize-assets.sh",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "balans": "node --no-warnings tools/balans.mjs --items",
    "test:rook": "playwright test tests/rook.spec.js --project=phone-portrait --project=tablet-landscape",
    "bouw:app": "node tools/bouw.mjs app",
    "app:sync": "node tools/bouw.mjs app && cap sync",
    "android:open": "cap open android",
    "ios:open": "cap open ios"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "^1.47.0"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3"
  }
}
